# Byte-compiled / cache de Python
__pycache__/
*.py[cod]
*$py.class

# Pytest y cobertura
.pytest_cache/
.coverage
htmlcov/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Variables de entorno y secretos (nunca versionar credenciales)
.env
.env.*
.streamlit/secrets.toml

# Archivos temporales del sistema operativo e IDEs
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Artefactos requeridos en GitHub para despliegue en Streamlit Community Cloud
!models/
!models/*.joblib
!models/metadata.json
!.streamlit/
!.streamlit/config.toml
!.python-version
